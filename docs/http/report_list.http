@host = http://localhost:8080
@context = /expbck
@token = paste-session-token-here

### List report: start without end
POST {{host}}{{context}}/report/list
Content-Type: application/json
Cookie: expenseCookie12={{token}}

{
  "Start": {
    "Month": 11,
    "Year": 2012
  }
}

### List report: start and end
POST {{host}}{{context}}/report/list
Content-Type: application/json
Cookie: expenseCookie12={{token}}

{
  "Start": {
    "Month": 11,
    "Year": 2012
  },
  "End": {
    "Month": 12,
    "Year": 2012
  }
}

### List report: start, end, end before start (expect 400)
POST {{host}}{{context}}/report/list
Content-Type: application/json
Cookie: expenseCookie12={{token}}

{
  "Start": {
    "Month": 5,
    "Year": 2013
  },
  "End": {
    "Month": 1,
    "Year": 2013
  }
}

### List report: missing start (expect 400)
POST {{host}}{{context}}/report/list
Content-Type: application/json
Cookie: expenseCookie12={{token}}

{}

### List report: start with ExcludeNone
POST {{host}}{{context}}/report/list
Content-Type: application/json
Cookie: expenseCookie12={{token}}

{
  "Start": {
    "Month": 11,
    "Year": 2012
  },
  "End": {
    "Month": 12,
    "Year": 2012
  },
  "ExcludeNone": false
}
