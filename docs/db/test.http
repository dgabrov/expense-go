# Add transaction: needs an existing account with id "acc-test-1" (FK on account_id)
POST http://localhost:8080/addTransaction
Content-Type: application/json

{
  "id": "tx-test-0001",
  "name": "Test groceries",
  "date": "2026-10-01",
  "amount": 12.5,
  "accountId": "acc-test-1",
  "categoryId": null
}

> {%
client.test("add transaction returns 200", function () {
  client.assert(response.status === 200, "expected 200, got " + response.status);
});
%}
